<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_mokopi_order_tree" model="ir.ui.view">
        <field name="name">mokopi.order.tree</field>
        <field name="model">mokopi.order</field>
        <field name="arch" type="xml">
            <tree string="Daftar Pesanan Aktif" decoration-info="status == 'dipesan'" decoration-warning="status == 'diproses'" decoration-success="status == 'siap'" decoration-muted="status in ('dibatalkan', 'ditolak')">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="customer_name"/>
                <field name="no_meja"/>
                <field name="status" widget="badge" decoration-info="status == 'dipesan'" decoration-warning="status == 'diproses'" decoration-success="status == 'siap'"/>
                <field name="create_date" string="Waktu Pesan"/>
            </tree>
        </field>
    </record>

    <record id="view_mokopi_order_form" model="ir.ui.view">
        <field name="name">mokopi.order.form</field>
        <field name="model">mokopi.order</field>
        <field name="arch" type="xml">
            <form string="Formulir Pesanan">
                <header>
                    <!-- Tombol Aksi sesuai STD (Sintaks Odoo 17) -->
                    <button name="action_diproses" string="Proses Pesanan" type="object" class="oe_highlight"
                            invisible="status != 'dipesan'" groups="mokopi.group_kds_front,mokopi.group_kds_kitchen"/>

                    <button name="action_siap" string="Pesanan Siap" type="object" class="oe_highlight"
                            invisible="status != 'diproses'" groups="mokopi.group_kds_front,mokopi.group_kds_kitchen"/>

                    <button name="action_ambil" string="Ambil Pesanan" type="object" class="oe_highlight"
                            invisible="status != 'siap'" groups="mokopi.group_kds_front"/>

                    <button name="action_tolak" string="Tolak Pesanan" type="object" class="btn-danger"
                            invisible="status not in ['dipesan', 'diproses']" groups="mokopi.group_kds_kitchen"/>

                    <button name="action_batalkan" string="Batalkan Pesanan" type="object" class="btn-secondary"
                            invisible="status not in ['dipesan', 'diproses', 'ditolak']" groups="mokopi.group_kds_front"/>

                    <field name="status" widget="statusbar" statusbar_visible="dipesan,diproses,siap,selesai"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="customer_name" required="1"/>
                            <field name="no_meja"/>
                        </group>
                        <group>
                            <field name="sequence"/>
                            <field name="for_bar"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Detail Pesanan" name="order_lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="menu_item_id"/>
                                    <field name="price" readonly="1" force_save="1"/>
                                    <field name="quantity"/>
                                    <field name="notes"/>
                                    <field name="subtotal" sum="Total"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
