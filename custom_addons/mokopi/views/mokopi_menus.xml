<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- 1. DEFINISI ACTIONS -->
    <record id="action_mokopi_kds_dashboard" model="ir.actions.client">
        <field name="name">KDS</field>
        <field name="tag">mokopi.kds.dashboard_action</field>
    </record>

    <record id="action_mokopi_cashier_dashboard" model="ir.actions.client">
        <field name="name">Kasir</field>
        <field name="tag">mokopi.cashier.dashboard_action</field>
    </record>

    <record id="action_mokopi_orders" model="ir.actions.act_window">
        <field name="name">Pesanan Aktif</field>
        <field name="res_model">mokopi.order</field>
        <field name="view_mode">tree</field>
    </record>

    <record id="action_mokopi_stock" model="ir.actions.act_window">
        <field name="name">Kelola Stok</field>
        <field name="res_model">mokopi.stock</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- 2. DEFINISI MENU -->

    <!-- Root Menu: Dibuat bersih tanpa grup bawaan -->
    <menuitem id="menu_mokopi_root"
              name="Mokopi" 
              sequence="5"/>

    <!-- Menu KDS: DIPAKSA HANYA UNTUK Kitchen Staff (mokopi.group_kds_kitchen) -->
    <!-- User Frontoffice (Kasir) TIDAK BOLEH ada di grup ini -->
    <menuitem id="menu_mokopi_kds_dashboard"
              name="KDS (Kitchen Display)"
              parent="menu_mokopi_root" 
              action="action_mokopi_kds_dashboard" 
              sequence="10"
              groups="mokopi.group_kds_kitchen"/>
    
    <!-- Menu Kasir: DIPAKSA HANYA UNTUK Front Office (mokopi.group_kds_front) -->
    <menuitem id="menu_mokopi_cashier_dashboard"
              name="Kasir"
              parent="menu_mokopi_root" 
              action="action_mokopi_cashier_dashboard" 
              sequence="20"
              groups="mokopi.group_kds_front"/>

    <!-- Menu Manajemen (Hanya untuk Admin/System) -->
    <menuitem id="menu_mokopi_orders"
              name="Daftar Pesanan Aktif"
              parent="menu_mokopi_root"
              action="action_mokopi_orders"
              sequence="30"
              groups="base.group_no_one"/>

    <menuitem id="menu_mokopi_stock"
              name="Manajemen Stok"
              parent="menu_mokopi_root"
              action="action_mokopi_stock"
              sequence="40"
              groups="base.group_system"/>
    
    <menuitem id="menu_mokopi_logs" 
              name="Riwayat Sistem" 
              parent="menu_mokopi_root" 
              action="action_mokopi_order_log" 
              sequence="50"
              groups="base.group_system"/>

</odoo>