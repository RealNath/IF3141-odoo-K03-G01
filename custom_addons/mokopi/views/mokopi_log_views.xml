<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_mokopi_order_log_tree" model="ir.ui.view">
        <field name="name">mokopi.order.log.tree</field>
        <field name="model">mokopi.order.log</field>
        <field name="arch" type="xml">
            <tree string="Order Logs" create="false" edit="false" delete="false" default_order="create_date desc">
                <field name="create_date" string="Waktu"/>
                <field name="order_name" string="Referensi"/>
                <field name="action_type" string="Aksi"/>
                <field name="description" string="Detail Perubahan"/>
                <field name="total_price" string="Total Nominal" sum="Total Keseluruhan"/>
            </tree>
        </field>
    </record>

    <record id="action_mokopi_order_log" model="ir.actions.act_window">
        <field name="name">Riwayat Pesanan</field>
        <field name="res_model">mokopi.order.log</field>
        <field name="view_mode">tree</field>
    </record>

</odoo>