<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="mokopi.CashierDashboard" owl="1">
        <div class="d-flex flex-column h-100 bg-view">
            
            <div class="h-50 overflow-auto p-3 border-bottom bg-light">
                <h4 class="mb-3">Pesanan Aktif</h4>
                <div class="row g-3">
                    <t t-foreach="state.orders" t-as="order" t-key="order.id">
                        <div class="col-md-3">
                            <div class="card shadow-sm h-100 border-info">
                                <div class="card-body d-flex flex-column">
                                    <h5 class="card-title"><t t-esc="order.name"/></h5>
                                    <h6 class="card-subtitle mb-2 text-muted">Pesanan: <t t-esc="order.order_number"/></h6>

                                    <hr/>

                                    <ul class="list-unstyled mb-3">
                                        <t t-foreach="order.full_lines" t-as="line" t-key="line.id">
                                            <li class="mb-1">
                                                <strong><t t-esc="line.quantity"/>x</strong> 
                                                <t t-esc="line.menu_item_id[1]"/>
                                                
                                                <t t-if="line.notes">
                                                    <br/><small class="text-danger">*** <t t-esc="line.notes"/> ***</small>
                                                </t>
                                            </li>
                                        </t>
                                    </ul>

                                    <select class="form-select form-select-sm mt-auto border-primary text-primary fw-bold" 
                                            t-on-change="(ev) => this.updateOrderStatus(order.id, ev.target.value)">
                                        
                                        <t t-foreach="getValidOptionsForOrder(order.status)" t-as="option" t-key="option[0]">
                                            
                                            <option t-att-value="option[0]" t-att-selected="order.status === option[0]">
                                                <t t-esc="option[1]"/>
                                            </option>
                                            
                                        </t>
                                    </select>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </div>

            <div class="h-50 d-flex flex-row">
                
                <div class="w-25 border-end p-3 d-flex flex-column bg-white">
                    <h4 class="mb-3">Pesanan Baru</h4>
                    
                    <input type="text" class="form-control mb-3" placeholder="Nomor Pesanan..." 
                           t-model="state.cart.order_number"/>
                    
                    <div class="flex-grow-1 overflow-auto border rounded p-2 mb-3">
                        <t t-if="state.cart.lines.length === 0">
                            <div class="text-muted text-center mt-3">Pesanan Kosong</div>
                        </t>
                        <t t-foreach="state.cart.lines" t-as="line" t-key="line_index">
                            <div class="d-flex justify-content-between align-items-center border-bottom py-1">
                                <div>
                                    <span class="fw-bold"><t t-esc="line.qty"/>x </span>
                                    <t t-esc="line.name"/>
                                </div>
                                <button class="btn btn-sm btn-link text-danger p-0" 
                                        t-on-click="() => this.removeFromCart(line_index)">
                                    <i class="fa fa-trash"/>
                                </button>
                            </div>
                        </t>
                    </div>

                    <button class="btn btn-success btn-lg w-100" 
                            t-att-disabled="state.cart.lines.length === 0"
                            t-on-click="submitOrder">
                        Kirim
                    </button>
                </div>

                <div class="w-75 p-3 overflow-auto bg-light">
                    
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="m-0">Menu</h4>
                        <input type="text" class="form-control bg-white" style="max-width: 250px;" 
                               placeholder="Cari menu..." 
                               t-model="state.searchQuery"/>
                    </div>

                    <div class="row g-2">
                        <t t-foreach="filteredMenuItems" t-as="item" t-key="item.id">
                            <div class="col-md-3 col-sm-4">
                                <div t-attf-class="card h-100 shadow-sm text-center cursor-pointer #{item.stock_qty &lt;= 0 ? 'opacity-50' : 'border-primary'}"
                                    t-on-click="() => this.addToCart(item)">
                                    
                                    <div class="card-body p-2 d-flex flex-column justify-content-center">
                                        <h6 class="card-title m-0"><t t-esc="item.name"/></h6>
                                        
                                        <t t-if="item.for_bar">
                                            <div class="d-flex justify-content-center align-items-center gap-2 mt-2">
                                                <button class="btn btn-outline-danger px-2 py-0 fw-bold" 
                                                        style="font-size: 0.8rem;"
                                                        t-on-click.stop="() => this.updateStock(item.id, -1)">-</button>
                                                
                                                <small class="text-muted m-0"><t t-esc="item.stock_qty"/> in stock</small>
                                                
                                                <button class="btn btn-outline-success px-2 py-0 fw-bold" 
                                                        style="font-size: 0.8rem;"
                                                        t-on-click.stop="() => this.updateStock(item.id, 1)">+</button>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <small class="text-muted mt-2"><t t-esc="item.stock_qty"/> in stock</small>
                                        </t>
                                        
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

            </div>
        </div>
    </t>

</templates>