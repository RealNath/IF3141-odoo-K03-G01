<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="mokopi.KdsDashboard" owl="1">
        <div class="o_kds_dashboard d-flex flex-column h-100 bg-view">
            
            <!-- AKSES DITOLAK VIEW -->
            <t t-if="!state.hasAccess">
                <div class="d-flex flex-column align-items-center justify-content-center h-100 text-muted">
                    <i class="fa fa-lock fa-5x mb-4 text-danger-emphasis"/>
                    <h2 class="fw-bold">Akses Terbatas</h2>
                    <p class="lead text-center">Halaman ini hanya untuk staf Dapur (Kitchen).<br/>Silakan hubungi administrator jika Anda memerlukan akses.</p>
                </div>
            </t>

            <!-- KONTEN DASHBOARD (Hanya jika punya akses) -->
            <t t-else="">
                <!-- SECTION 1: ANTREAN PESANAN -->
                <div class="flex-grow-1 overflow-auto p-4 border-bottom bg-light">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h4 class="m-0 fw-bold text-primary"><i class="fa fa-fire me-2"/>Antrean Dapur (Kitchen)</h4>
                        <span class="badge rounded-pill bg-primary"><t t-esc="state.orders.length"/> Pesanan Aktif</span>
                    </div>

                    <div class="row g-3">
                        <t t-foreach="state.orders" t-as="order" t-key="order.id">
                            <div class="col-md-3">
                                <div t-attf-class="card shadow-sm h-100 border-0 border-top border-4 #{order.status === 'siap' ? 'border-success' : 'border-info'}"
                                     draggable="true"
                                     t-on-dragstart="(ev) => this.onDragStart(ev, order)"
                                     t-on-dragover="(ev) => this.onDragOver(ev)"
                                     t-on-drop="(ev) => this.onDrop(ev, order)"
                                     style="cursor: grab;">
                                    <div class="card-body d-flex flex-column p-3">
                                        <div class="d-flex justify-content-between align-items-start mb-2">
                                            <h6 class="fw-bold m-0"><t t-esc="order.customer_name"/></h6>
                                            <span class="badge bg-secondary small">Meja <t t-esc="order.no_meja or '-'"/></span >
                                        </div>
                                        <h6 class="card-subtitle mb-2 text-muted small">#<t t-esc="order.order_number"/></h6>

                                        <hr class="my-2"/>

                                        <ul class="list-unstyled mb-3 flex-grow-1">
                                            <t t-foreach="order.full_lines" t-as="line" t-key="line.id">
                                                <li class="mb-1 d-flex justify-content-between">
                                                    <span><strong class="text-primary"><t t-esc="line.quantity"/>x</strong> <t t-esc="line.menu_item_id[1]"/></span>
                                                </li>
                                            </t>
                                        </ul>

                                        <div class="mt-auto pt-2 border-top">
                                            <label class="small text-muted mb-1 d-block fw-bold">Update Status:</label>
                                            <select class="form-select form-select-sm border-info text-info fw-bold"
                                                    t-on-change="(ev) => this.updateOrderStatus(order.id, ev.target.value)">
                                                <t t-foreach="getValidOptionsForOrder(order)" t-as="option" t-key="option[0]">
                                                    <option t-att-value="option[0]" t-att-selected="order.status === option[0]">
                                                        <t t-esc="option[1]"/>
                                                    </option>
                                                </t>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>

                <!-- SECTION 2: MONITOR STOK (VIEW ONLY) -->
                <div class="h-40 overflow-auto p-4 bg-white">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="m-0 text-muted fw-bold"><i class="fa fa-cubes me-2"/>Monitor Stok Makanan</h5>
                        <div class="input-group" style="max-width: 250px;">
                            <span class="input-group-text bg-light border-end-0"><i class="fa fa-search small"/></span>
                            <input type="text" class="form-control form-control-sm border-start-0"
                                    placeholder="Cari menu..."
                                    t-model="state.searchQuery"/>
                        </div>
                    </div>

                    <div class="row g-2">
                        <t t-foreach="filteredMenuItems" t-as="item" t-key="item.id">
                            <div class="col-md-2 col-sm-4">
                                <div t-attf-class="card h-100 shadow-none border rounded text-center #{item.stock_qty &lt;= 0 ? 'bg-danger-subtle border-danger' : 'bg-light'}">
                                    <div class="card-body p-2 d-flex flex-column justify-content-center align-items-center">
                                        <h6 t-attf-class="small fw-bold m-0 #{item.stock_qty &lt;= 0 ? 'text-danger' : ''}"><t t-esc="item.name"/></h6>

                                        <div class="d-flex align-items-center justify-content-center gap-2 my-1">
                                            <button class="btn btn-sm btn-outline-secondary p-0 px-2" t-on-click="() => this.updateStock(item.id, -1)">-</button>
                                            <div t-attf-class="fw-bold #{item.stock_qty &lt;= 0 ? 'text-danger' : 'text-primary'}" style="min-width: 25px;">
                                                <t t-esc="item.stock_qty"/>
                                            </div>
                                            <button class="btn btn-sm btn-outline-secondary p-0 px-2" t-on-click="() => this.updateStock(item.id, 1)">+</button>
                                        </div>

                                        <t t-if="item.stock_qty &lt;= 0">
                                            <span class="badge bg-danger x-small">HABIS</span>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </div>
            </t>
        </div>
    </t>

</templates>
