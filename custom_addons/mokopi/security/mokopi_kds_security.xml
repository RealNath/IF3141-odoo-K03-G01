<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <!-- Definisi Kategori Utama Mokopi -->
        <record id="module_category_mokopi" model="ir.module.category">
            <field name="name">Mokopi</field>
            <field name="sequence">10</field>
            <field name="is_application">True</field>
        </record>

        <!-- Role Kasir -->
        <record id="group_kds_front" model="res.groups">
            <field name="name">Kasir</field>
            <field name="category_id" ref="module_category_mokopi"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>

        <!-- Role Kitchen Staff -->
        <record id="group_kds_kitchen" model="res.groups">
            <field name="name">Kitchen Staff</field>
            <field name="category_id" ref="module_category_mokopi"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
        </record>
    </data>
</odoo>
